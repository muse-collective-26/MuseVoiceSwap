      "widgets_values": [
        "{\"schema_version\":1,\"source_duration\":40.031,\"vocalSegments\":[{\"id\":\"seg_1\",\"start\":0,\"end\":0.6,\"text\":\"Wow,\",\"emotion_text\":\"[surprised] Wow,\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_2\",\"start\":1,\"end\":21.4,\"text\":\"I wasn't actually expecting to stop today. But sometimes those are the places end up being your favor. I spotted this little town completely by accident, pulled over for a coffee, and honestly, I haven't wanted to leave since. Everything just moves at a different pace here. The streets are quiet, every building has its own character, and around every corner, there's another little cafe or hidden square.\",\"emotion_text\":\"[thoughtful] I wasn't actually expecting to stop today. [softly] But sometimes those are the places end up being your favour. I spotted this little town completely by accident, pulled over for a coffee, and honestly, I haven't wanted to leave since. Everything just moves at a different pace here. The streets are quiet, every building has its own character, and around every corner, there's another little cafe or hidden square.\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_3\",\"start\":21.6,\"end\":40,\"text\":\"It feels like the sort of place where nobody's in a hurry, and after five minutes, you neither are you. These are the places I always remember the most, not because they're famous, but because they make you slow down long enough to actually notice where you are. If you're ever nearby, don't just drive through. Stay for a coffee. You might end up loving it as much as I did.\",\"emotion_text\":\"[calm] It feels like the sort of place where nobody's in a hurry, and after five minutes, you neither are you. [warm] These are the places I always remember the most, not because they're famous, but because they make you slow down long enough to actually notice where you are. [gentle] If you're ever nearby, don't just drive through. Stay for a coffee. [hopeful] You might end up loving it as much as I did.\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false}],\"bgWaveformPeaks\":[0.00501,0.00907,0.00859,0.00444,0.00158,0.00094,0.00119,0.00126,0.00125,0.00217,0.00338,0.00219,0.00511,0.00341,0.0048,0.00284,0.00217,0.00203,0.00199,0.00305,0.00297,0.0017,0.00241,0.00172,0.00186,0.00122,0.02267,0.00302,0.00243,0.00127,0.00132,0.00122,0.00143,0.00172,0.0015,0.00243,0.00194,0.00251,0.0013,0.00257,0.00359,0.00209,0.00125,0.00125,0.00219,0.00296,0.00176,0.00178,0.00312,0.0026,0.00121,0.00262,0.00344,0.00251,0.00113,0.00348,0.00347,0.00281,0.00079,0.00084,0.00121,0.00156,0.00108,0.00147,0.00141,0.00179,0.00174,0.00148,0.00132,0.00305,0.01654,0.00202,0.00259,0.00259,0.00159,0.00168,0.00269,0.0013,0.00149,0.00267,0.00278,0.001,0.00114,0.00121,0.00116,0.00156,0.00118,0.00222,0.00227,0.00255,0.00148,0.00175,0.00117,0.00101,0.00104,0.00121,0.00126,0.0025,0.00166,0.0015,0.00132,0.00201,0.00221,0.00254,0.00482,0.0022,0.00136,0.00295,0.00413,0.00238,0.00295,0.00137,0.0032,0.00122,0.00149,0.0014,0.00205,0.00174,0.00234,0.00355,0.00365,0.00166,0.00353,0.00232,0.0008,0.00092,0.00123,0.00176,0.01023,0.01558,0.00265,0.00282,0.00216,0.00133,0.00188,0.00168,0.00195,0.00159,0.0018,0.00154,0.00068,0.00103,0.00271,0.0024,0.00184,0.00236,0.00192,0.00115,0.00123,0.00155,0.00146,0.00145,0.00147,0.00101,0.00095,0.00107,0.00141,0.00156,0.00291,0.0024,0.0011,0.00161,0.0016,0.00173,0.0015,0.00165,0.00164,0.00336,0.00167,0.00135,0.00133,0.00194,0.00127,0.00184,0.00198,0.00168,0.00088,0.00105,0.00101,0.00122,0.00157,0.00184,0.00196,0.00336,0.00248,0.00272,0.00119,0.00128,0.00112,0.00233,0.00219,0.00258,0.00127,0.00109,0.00178,0.00201,0.0021,0.00166,0.00131,0.0015,0.0014,0.00116,0.00185,0.0023,0.00126,0.00086,0.0014,0.00319,0.0029,0.00119,0.00258,0.0028,0.00162,0.00098,0.00124,0.00179,0.00156,0.00161,0.00624,0.00