        "",
        "{\"schema_version\":1,\"source_duration\":16.52,\"vocalSegments\":[{\"id\":\"seg_1\",\"start\":0.232,\"end\":2.113,\"text\":\"John, I just don't know.\",\"emotion_text\":\"John, [disappointed] I just don't know.\",\"speaker\":2,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_2\",\"start\":2.523260273972603,\"end\":5.41,\"text\":\"It looks very much like radiation, but...\",\"emotion_text\":\"It looks very much like radiation, but... [pauses]\",\"speaker\":2,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_3\",\"start\":5.747,\"end\":6.548,\"text\":\"But what?\",\"emotion_text\":\"[confused] But what?\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_4\",\"start\":7.523,\"end\":9.009,\"text\":\"There is no radiation.\",\"emotion_text\":\"[calm] There is no radiation.\",\"speaker\":2,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_6\",\"start\":12.341,\"end\":12.643,\"text\":\"lecture.\",\"emotion_text\":\"[confused] Victor.\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false},{\"id\":\"seg_7\",\"start\":12.957,\"end\":16.475,\"text\":\"You know me well enough to know I'm not going to ignore the fact that people are dying up here.\",\"emotion_text\":\"[serious] You know me well enough to know I'm not going to ignore the fact that people are dying up here.\",\"speaker\":1,\"reference_audio_override\":\"\",\"reference_text_override\":\"\",\"locked\":false}],\"bgWaveformPeaks\":[0.00924,0.00947,0.00874,0.00883,0.00909,0.0078,0.0093,0.01175,0.00868,0.01154,0.00965,0.0087,0.00666,0.00723,0.00764,0.00783,0.00767,0.00706,0.00644,0.00617,0.00599,0.00645,0.0078,0.00758,0.00797,0.00839,0.00626,0.00716,0.00686,0.008,0.00883,0.0082,0.00634,0.00634,0.01005,0.00752,0.00619,0.00867,0.00837,0.0099,0.00946,0.00916,0